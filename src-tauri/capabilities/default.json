{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DATA/notty/vault" },
        { "path": "$DATA/notty/vault/**" },
        { "path": "$DATA/notty/vault/.*" },
        { "path": "$DATA/notty/vault/.notty" },
        { "path": "$DATA/notty/vault/.notty/**" },
        { "path": "$DATA/notty/vault/.trash" },
        { "path": "$DATA/notty/vault/.trash/**" }
      ]
    },
    "fs:allow-exists",
    "fs:allow-lstat",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-write-text-file",
    "sql:default",
    "sql:allow-execute",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
